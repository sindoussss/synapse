# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated evaluation artifacts (may contain client documents)
/public/agreements/
/public/invoices/
/.proposals_pdf/
/qa-artifacts/
/generated-sites/
/.data/
/production-sites/
/release-workspaces/
**/*_cache.json
.*_cache.json

# misc
.DS_Store
Thumbs.db
*.pem
*.p12
*.key
credentials.json
**/secrets/**
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment and credentials — never commit
.env
.env.*
.env.local
!.env.example

# vercel
.vercel

# editor / agent scaffolding
AGENTS.md
CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts
