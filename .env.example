# Copy this file to `.env.local` and fill in values locally.
# Do not commit `.env.local` or any live credentials.

# Persistence (optional for local JSON-backed evaluation)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Model routing. Leave blank to disable a provider.
GEMINI_API_KEY=
GEMINI_FREE_ENABLED=false
GROQ_API_KEY=
GROQ_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_ENABLED=true

# Optional integrations. Leave blank unless the corresponding experiment is enabled.
VERCEL_TOKEN=
GMAIL_USER=
GMAIL_APP_PASSWORD=
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEST_MODE=true
DROPBOX_SIGN_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Process-bound operator HTTP credential (machine Bearer). Unset = bearer auth fail closed.
# Do not expose this to the browser. Browser login uses a server-issued httpOnly session.
SYNAPSE_OPERATOR_TOKEN=
# Optional distinct login password. If unset, login compares against SYNAPSE_OPERATOR_TOKEN.
SYNAPSE_OPERATOR_PASSWORD=
# Optional HMAC key for operator session cookies. If unset, derived from SYNAPSE_OPERATOR_TOKEN.
SYNAPSE_SESSION_SECRET=
# Optional tenant / workspace binding for the operator principal. Not a user directory.
SYNAPSE_OPERATOR_ORGANIZATION_ID=
SYNAPSE_OPERATOR_WORKSPACE_ID=
