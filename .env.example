# Copy this file to `.env.local` and fill in values locally.
# Do not commit `.env.local` or any live credentials.

# Persistence (optional for local JSON-backed evaluation)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Model routing. Leave blank to disable a provider.
GEMINI_API_KEY=
GEMINI_FREE_ENABLED=false
GROQ_API_KEY=
GROQ_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_ENABLED=true

# Optional integrations. Leave blank unless the corresponding experiment is enabled.
VERCEL_TOKEN=
GMAIL_USER=
GMAIL_APP_PASSWORD=
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEST_MODE=true
DROPBOX_SIGN_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
